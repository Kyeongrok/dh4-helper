<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:support="clr-namespace:Dh4Launcher.Support.UI.Units;assembly=Dh4Launcher.Support"
    xmlns:conv="clr-namespace:Dh4Launcher.Forms.Converters"
    xmlns:views="clr-namespace:Dh4Launcher.Forms.UI.Views">

    <conv:EqualsVisibilityConverter x:Key="EqVis" />

    <!--  배경색은 버튼별로 지정, 호버/비활성은 투명도로 처리해 색에 무관하게 동작  -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Type support:Dh4LauncherWindow}}" TargetType="{x:Type views:MainWindow}">
        <Setter Property="Title" Value="Dh4Launcher" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:MainWindow}">
                    <!--  액자 프레임: 금색/갈색 그라데이션 테두리 + 갈색 배경  -->
                    <Border BorderBrush="#241809" BorderThickness="1">
                        <Border.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="/Dh4Launcher.Support;component/Themes/Units/ScrollBarStyle.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </Border.Resources>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#F0DEAA" />
                                <GradientStop Offset="0.35" Color="#CDA864" />
                                <GradientStop Offset="0.72" Color="#8C6630" />
                                <GradientStop Offset="1" Color="#5A3F1B" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Margin="7" BorderBrush="#241809" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#6E5236" />
                                    <GradientStop Offset="1" Color="#4A3624" />
                                </LinearGradientBrush>
                            </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Title Bar  -->
                            <Grid Grid.Row="0" Background="#3E2C1A">
                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#CCCCCC"
                                    Text="{TemplateBinding Title}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <!--  Minimize  -->
                                    <support:MinimizeButton x:Name="PART_MinimizeButton" />
                                    <!--  Maximize  -->
                                    <support:MaximizeButton x:Name="PART_MaximizeButton" />
                                    <!--  Close  -->
                                    <support:CloseButton x:Name="PART_CloseButton" />
                                </StackPanel>
                            </Grid>

                            <!--  Content Area  -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  탭 바  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="10,8,0,4"
                                    Orientation="Horizontal">
                                    <support:GameTabButton
                                        Width="96"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="0"
                                        Content="설정">
                                        <support:GameTabButton.Style>
                                            <Style TargetType="{x:Type support:GameTabButton}">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </support:GameTabButton.Style>
                                    </support:GameTabButton>
                                    <support:GameTabButton
                                        Width="96"
                                        Margin="8,0,0,0"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="1"
                                        Content="초상화">
                                        <support:GameTabButton.Style>
                                            <Style TargetType="{x:Type support:GameTabButton}">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </support:GameTabButton.Style>
                                    </support:GameTabButton>
                                    <support:GameTabButton
                                        Width="96"
                                        Margin="8,0,0,0"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="2"
                                        Content="컷신">
                                        <support:GameTabButton.Style>
                                            <Style TargetType="{x:Type support:GameTabButton}">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTab}" Value="2">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </support:GameTabButton.Style>
                                    </support:GameTabButton>
                                </StackPanel>

                                <!--  ===== 탭 0: 설정 =====  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=0}">
                                <StackPanel
                                    Margin="0,16"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">

                                    <!--  ===== 왼쪽: 게임 설정 =====  -->
                                    <StackPanel Width="220" Orientation="Vertical">

                                    <!--  게임 폴더 표시 + 변경  -->
                                    <support:GameLabel Margin="0,0,0,6" Content="게임 폴더" />
                                    <TextBlock
                                        Width="220"
                                        FontSize="11"
                                        Foreground="#9A9A9A"
                                        Text="{Binding GamePath}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding GamePath}" />
                                    <support:GameFrameButton
                                        Width="220"
                                        Height="38"
                                        Margin="0,4,0,16"
                                        Command="{Binding ChangeGamePathCommand}"
                                        Content="폴더 변경"
                                        FontSize="13" />

                                    <support:GameLabel Margin="0,0,0,6" Content="해상도" />
                                    <ComboBox
                                        Width="220"
                                        Padding="8,4"
                                        FontSize="14"
                                        ItemsSource="{Binding Resolutions}"
                                        SelectedItem="{Binding SelectedResolution}" />

                                    <CheckBox
                                        Margin="0,16,0,0"
                                        Content="전체 화면"
                                        Foreground="#CCCCCC"
                                        IsChecked="{Binding IsFullscreen}" />
                                    <support:GameFrameButton
                                        Width="220"
                                        Height="40"
                                        Margin="0,10,0,0"
                                        Command="{Binding SaveCommand}"
                                        Content="해상도 적용"
                                        FontSize="14" />

                                    <support:GameLabel Margin="0,16,0,6" Content="언어" />
                                    <ComboBox
                                        Width="220"
                                        Padding="8,4"
                                        FontSize="14"
                                        ItemsSource="{Binding Languages}"
                                        SelectedItem="{Binding SelectedLanguage}" />

                                    <!--  고성능 GPU 설정  -->
                                    <support:GameLabel Margin="0,16,0,6" Content="고성능 GPU" />
                                    <TextBlock
                                        Width="220"
                                        FontSize="11"
                                        Foreground="#8A8A8A"
                                        Text="GPU(그래픽카드)가 있으면 [적용]을 누르면 게임이 조금 빨라집니다."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Width="220"
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="#9A9A9A"
                                        Text="{Binding GpuStatus}"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Width="220"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                        <support:GameFrameButton
                                            Width="105"
                                            Height="38"
                                            MinWidth="0"
                                            Command="{Binding ApplyGpuCommand}"
                                            Content="적용"
                                            FontSize="13" />
                                        <support:GameFrameButton
                                            Width="105"
                                            Height="38"
                                            Margin="10,0,0,0"
                                            MinWidth="0"
                                            Command="{Binding CancelGpuCommand}"
                                            Content="취소"
                                            FontSize="13" />
                                    </StackPanel>

                                    <support:GameFrameButton
                                        Width="220"
                                        Height="54"
                                        Margin="0,24,0,0"
                                        Command="{Binding LaunchCommand}"
                                        Content="게임 실행" />
                                    <TextBlock
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#6FCF6F"
                                        Text="{Binding StatusMessage}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#E0B45C"
                                        Text="{Binding UpdateStatus}" />
                                    </StackPanel>

                                    <!--  ===== 오른쪽: 키매핑 =====  -->
                                    <StackPanel
                                        Width="220"
                                        Margin="24,0,0,0"
                                        Orientation="Vertical">

                                    <!--  방향 키 매핑 (DK4HD_kr.exe 패치)  -->
                                    <support:GameLabel Margin="0,0,0,6" Content="돛 조타 키 (좌/우)" />
                                    <StackPanel Width="220" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="왼쪽" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding LeftKey}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="오른쪽" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding RightKey}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <support:GameLabel Margin="0,12,0,6" Content="배 선회 키 (위/아래)" />
                                    <StackPanel Width="220" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="위" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding UpKey}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="아래" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding DownKey}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <support:GameLabel Margin="0,12,0,6" Content="지도 키 (기본 F1)" />
                                    <ComboBox
                                        Width="220"
                                        Padding="8,4"
                                        FontSize="13"
                                        ItemsSource="{Binding Keys}"
                                        SelectedItem="{Binding MapKey}" />

                                    <!--  보조 키 (넘패드 기능 재매핑)  -->
                                    <support:GameLabel Margin="0,12,0,6" Content="보조 키 (넘패드 기능)" />
                                    <StackPanel Width="220" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 +" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding NumPlusKey}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 −" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding NumMinusKey}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,6,0,0" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 4" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding Num4Key}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 6" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding Num6Key}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        Width="220"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                        <support:GameFrameButton
                                            Width="105"
                                            Height="38"
                                            MinWidth="0"
                                            Command="{Binding ApplyKeyMapCommand}"
                                            Content="적용"
                                            FontSize="13" />
                                        <support:GameFrameButton
                                            Width="105"
                                            Height="38"
                                            Margin="10,0,0,0"
                                            MinWidth="0"
                                            Command="{Binding RestoreKeyMapCommand}"
                                            Content="기본값(←→)"
                                            FontSize="12" />
                                    </StackPanel>
                                    <TextBlock
                                        Width="220"
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="#9A9A9A"
                                        Text="{Binding KeyMapStatus}"
                                        TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>

                                <!--  ===== 탭 1: 초상화 =====  -->
                                <Grid
                                    Grid.Row="1"
                                    Margin="10,4,10,10"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=1}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>

                                    <!--  갤러리  -->
                                    <ListBox
                                        Grid.Column="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding Portrait.Portraits}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectedItem="{Binding Portrait.Selected}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="86" Margin="2">
                                                    <Image Width="80" Source="{Binding Thumbnail}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="#EEEEEE"
                                                        Text="{Binding Index}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!--  미리보기 + 컨트롤  -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <ComboBox
                                            Margin="0,0,0,6"
                                            Padding="8,4"
                                            DisplayMemberPath="Display"
                                            FontSize="12"
                                            ItemsSource="{Binding Portrait.Files}"
                                            SelectedItem="{Binding Portrait.SelectedFile}" />
                                        <Border Background="#33000000" CornerRadius="4" Padding="4">
                                            <Image
                                                Height="220"
                                                Source="{Binding Portrait.FullImage}"
                                                Stretch="Uniform" />
                                        </Border>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="#DDDDDD"
                                            Text="{Binding Portrait.Status}"
                                            TextWrapping="Wrap" />
                                        <support:GameFrameButton
                                            Height="38"
                                            Margin="0,8,0,0"
                                            MinWidth="0"
                                            Command="{Binding Portrait.ReplaceCommand}"
                                            Content="이미지로 교체"
                                            FontSize="13" />
                                        <support:GameFrameButton
                                            Height="34"
                                            Margin="0,6,0,0"
                                            MinWidth="0"
                                            Command="{Binding Portrait.ExportCommand}"
                                            Content="PNG 내보내기"
                                            FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <!--  ===== 탭 2: 컷신 (EventBG) =====  -->
                                <Grid
                                    Grid.Row="1"
                                    Margin="10,4,10,10"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=2}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>

                                    <!--  갤러리  -->
                                    <ListBox
                                        Grid.Column="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding Cutscene.Portraits}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectedItem="{Binding Cutscene.Selected}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="120" Margin="2">
                                                    <Image Width="114" Source="{Binding Thumbnail}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="#EEEEEE"
                                                        Text="{Binding Index}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!--  미리보기 + 컨트롤  -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <ComboBox
                                            Margin="0,0,0,6"
                                            Padding="8,4"
                                            DisplayMemberPath="Display"
                                            FontSize="12"
                                            ItemsSource="{Binding Cutscene.Files}"
                                            SelectedItem="{Binding Cutscene.SelectedFile}" />
                                        <Border Background="#33000000" CornerRadius="4" Padding="4">
                                            <Image
                                                Height="180"
                                                Source="{Binding Cutscene.FullImage}"
                                                Stretch="Uniform" />
                                        </Border>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="#DDDDDD"
                                            Text="{Binding Cutscene.Status}"
                                            TextWrapping="Wrap" />
                                        <support:GameFrameButton
                                            Height="38"
                                            Margin="0,8,0,0"
                                            MinWidth="0"
                                            Command="{Binding Cutscene.ReplaceCommand}"
                                            Content="이미지로 교체"
                                            FontSize="13" />
                                        <support:GameFrameButton
                                            Height="34"
                                            Margin="0,6,0,0"
                                            MinWidth="0"
                                            Command="{Binding Cutscene.ExportCommand}"
                                            Content="PNG 내보내기"
                                            FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
