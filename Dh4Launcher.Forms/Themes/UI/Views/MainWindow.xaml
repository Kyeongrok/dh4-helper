<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:support="clr-namespace:Dh4Launcher.Support.UI.Units;assembly=Dh4Launcher.Support"
    xmlns:conv="clr-namespace:Dh4Launcher.Forms.Converters"
    xmlns:views="clr-namespace:Dh4Launcher.Forms.UI.Views">

    <conv:EqualsVisibilityConverter x:Key="EqVis" />

    <!--  배경색은 버튼별로 지정, 호버/비활성은 투명도로 처리해 색에 무관하게 동작  -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Type support:Dh4LauncherWindow}}" TargetType="{x:Type views:MainWindow}">
        <Setter Property="Title" Value="Dh4Launcher" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:MainWindow}">
                    <!--  액자 프레임: 금색/갈색 그라데이션 테두리 + 갈색 배경  -->
                    <Border BorderBrush="#241809" BorderThickness="1">
                        <Border.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="/Dh4Launcher.Support;component/Themes/Units/ScrollBarStyle.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </Border.Resources>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#F0DEAA" />
                                <GradientStop Offset="0.35" Color="#CDA864" />
                                <GradientStop Offset="0.72" Color="#8C6630" />
                                <GradientStop Offset="1" Color="#5A3F1B" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Margin="7" BorderBrush="#241809" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#6E5236" />
                                    <GradientStop Offset="1" Color="#4A3624" />
                                </LinearGradientBrush>
                            </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Title Bar  -->
                            <Grid Grid.Row="0" Background="#3E2C1A">
                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#CCCCCC"
                                    Text="{TemplateBinding Title}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <!--  Minimize  -->
                                    <support:MinimizeButton x:Name="PART_MinimizeButton" />
                                    <!--  Maximize  -->
                                    <support:MaximizeButton x:Name="PART_MaximizeButton" />
                                    <!--  Close  -->
                                    <support:CloseButton x:Name="PART_CloseButton" />
                                </StackPanel>
                            </Grid>

                            <!--  Content Area  -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  탭 바  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="10,8,0,4"
                                    Orientation="Horizontal">
                                    <support:GameTabButton
                                        Width="80"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="0"
                                        Content="설정">
                                        <support:GameTabButton.Style>
                                            <Style TargetType="{x:Type support:GameTabButton}">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </support:GameTabButton.Style>
                                    </support:GameTabButton>
                                    <support:GameTabButton
                                        Width="80"
                                        Margin="8,0,0,0"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="1"
                                        Content="키설정">
                                        <support:GameTabButton.Style>
                                            <Style TargetType="{x:Type support:GameTabButton}">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </support:GameTabButton.Style>
                                    </support:GameTabButton>
                                    <support:GameTabButton
                                        Width="80"
                                        Margin="8,0,0,0"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="2"
                                        Content="이미지">
                                        <support:GameTabButton.Style>
                                            <Style TargetType="{x:Type support:GameTabButton}">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTab}" Value="2">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </support:GameTabButton.Style>
                                    </support:GameTabButton>
                                    <support:GameTabButton
                                        Width="80"
                                        Margin="8,0,0,0"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="3"
                                        Content="지도">
                                        <support:GameTabButton.Style>
                                            <Style TargetType="{x:Type support:GameTabButton}">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTab}" Value="3">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </support:GameTabButton.Style>
                                    </support:GameTabButton>
                                    <support:GameTabButton
                                        Width="80"
                                        Margin="8,0,0,0"
                                        Command="{Binding SelectTabCommand}"
                                        CommandParameter="4"
                                        Content="세이브">
                                        <support:GameTabButton.Style>
                                            <Style TargetType="{x:Type support:GameTabButton}">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTab}" Value="4">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </support:GameTabButton.Style>
                                    </support:GameTabButton>
                                </StackPanel>

                                <!--  ===== 탭 0: 설정 =====  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=0}">
                                <StackPanel
                                    Margin="0,16"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">

                                    <!--  ===== 왼쪽: 게임 설정 =====  -->
                                    <StackPanel Width="220" Orientation="Vertical">

                                    <!--  게임 폴더 표시 + 변경  -->
                                    <support:GameLabel Margin="0,0,0,6" Content="게임 폴더" />
                                    <TextBlock
                                        Width="220"
                                        FontSize="11"
                                        Foreground="#9A9A9A"
                                        Text="{Binding GamePath}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding GamePath}" />
                                    <support:GameFrameButton
                                        Width="220"
                                        Height="38"
                                        Margin="0,4,0,16"
                                        Command="{Binding ChangeGamePathCommand}"
                                        Content="폴더 변경"
                                        FontSize="13" />

                                    <support:GameLabel Margin="0,0,0,6" Content="해상도" />
                                    <ComboBox
                                        Width="220"
                                        Padding="8,4"
                                        FontSize="14"
                                        ItemsSource="{Binding Resolutions}"
                                        SelectedItem="{Binding SelectedResolution}" />

                                    <CheckBox
                                        Margin="0,16,0,0"
                                        Content="전체 화면"
                                        Foreground="#CCCCCC"
                                        IsChecked="{Binding IsFullscreen}" />
                                    <support:GameFrameButton
                                        Width="220"
                                        Height="40"
                                        Margin="0,10,0,0"
                                        Command="{Binding SaveCommand}"
                                        Content="해상도 적용"
                                        FontSize="14" />

                                    <support:GameLabel Margin="0,16,0,6" Content="언어" />
                                    <ComboBox
                                        Width="220"
                                        Padding="8,4"
                                        FontSize="14"
                                        ItemsSource="{Binding Languages}"
                                        SelectedItem="{Binding SelectedLanguage}" />

                                    <!--  고성능 GPU 설정  -->
                                    <support:GameLabel Margin="0,16,0,6" Content="고성능 GPU" />
                                    <TextBlock
                                        Width="220"
                                        FontSize="11"
                                        Foreground="#8A8A8A"
                                        Text="GPU(그래픽카드)가 있으면 [적용]을 누르면 게임이 조금 빨라집니다."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Width="220"
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="#9A9A9A"
                                        Text="{Binding GpuStatus}"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Width="220"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                        <support:GameFrameButton
                                            Width="105"
                                            Height="38"
                                            MinWidth="0"
                                            Command="{Binding ApplyGpuCommand}"
                                            Content="적용"
                                            FontSize="13" />
                                        <support:GameFrameButton
                                            Width="105"
                                            Height="38"
                                            Margin="10,0,0,0"
                                            MinWidth="0"
                                            Command="{Binding CancelGpuCommand}"
                                            Content="취소"
                                            FontSize="13" />
                                    </StackPanel>

                                    </StackPanel>

                                </StackPanel>
                                </ScrollViewer>

                                <!--  ===== 탭 1: 키설정 (DK4HD_kr.exe 패치) =====  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=1}">
                                    <StackPanel
                                        Width="220"
                                        Margin="0,16"
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical">

                                    <!--  방향 키 매핑 (DK4HD_kr.exe 패치)  -->
                                    <support:GameLabel Margin="0,0,0,6" Content="돛 조타 키 (좌/우)" />
                                    <StackPanel Width="220" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="왼쪽" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding LeftKey}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="오른쪽" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding RightKey}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <support:GameLabel Margin="0,12,0,6" Content="배 선회 키 (위/아래)" />
                                    <StackPanel Width="220" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="위" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding UpKey}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="아래" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding DownKey}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <support:GameLabel Margin="0,12,0,6" Content="지도 키 (기본 F1)" />
                                    <ComboBox
                                        Width="220"
                                        Padding="8,4"
                                        FontSize="13"
                                        ItemsSource="{Binding Keys}"
                                        SelectedItem="{Binding MapKey}" />

                                    <!--  기능 키 F2~F5 재매핑  -->
                                    <support:GameLabel Margin="0,12,0,6" Content="기능 키 (F2~F5)" />
                                    <StackPanel Width="220" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="F2" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding F2Key}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="F3" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding F3Key}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,6,0,0" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="F4" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding F4Key}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="F5" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding F5Key}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  보조 키 (넘패드 기능 재매핑)  -->
                                    <support:GameLabel Margin="0,12,0,6" Content="보조 키 (넘패드 기능)" />
                                    <StackPanel Width="220" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 +" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding NumPlusKey}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 −" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding NumMinusKey}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,6,0,0" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 4" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding Num4Key}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 6" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding Num6Key}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Width="220" Margin="0,6,0,0" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 7" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding Num7Key}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 9" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding Num9Key}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,6,0,0" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 1" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding Num1Key}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="넘패드 3" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding Num3Key}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        Width="220"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                        <support:GameFrameButton
                                            Width="105"
                                            Height="38"
                                            MinWidth="0"
                                            Command="{Binding ApplyKeyMapCommand}"
                                            Content="적용"
                                            FontSize="13" />
                                        <support:GameFrameButton
                                            Width="105"
                                            Height="38"
                                            Margin="10,0,0,0"
                                            MinWidth="0"
                                            Command="{Binding RestoreKeyMapCommand}"
                                            Content="기본값(←→)"
                                            FontSize="12" />
                                    </StackPanel>
                                    <TextBlock
                                        Width="220"
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="#9A9A9A"
                                        Text="{Binding KeyMapStatus}"
                                        TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!--  ===== 탭 2: 이미지 (초상화/컷신/도시/건물 공통) =====  -->
                                <Grid
                                    Grid.Row="1"
                                    Margin="10,4,10,10"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=2}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!--  하위 메뉴 (초상화/컷신/도시/건물)  -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                                        <support:GameTabButton
                                            Width="70"
                                            Command="{Binding SelectImageSubTabCommand}"
                                            CommandParameter="0"
                                            Content="초상화"
                                            FontSize="12">
                                            <support:GameTabButton.Style>
                                                <Style TargetType="{x:Type support:GameTabButton}">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ImageSubTab}" Value="0">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </support:GameTabButton.Style>
                                        </support:GameTabButton>
                                        <support:GameTabButton
                                            Width="70"
                                            Margin="6,0,0,0"
                                            Command="{Binding SelectImageSubTabCommand}"
                                            CommandParameter="1"
                                            Content="컷신"
                                            FontSize="12">
                                            <support:GameTabButton.Style>
                                                <Style TargetType="{x:Type support:GameTabButton}">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ImageSubTab}" Value="1">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </support:GameTabButton.Style>
                                        </support:GameTabButton>
                                        <support:GameTabButton
                                            Width="70"
                                            Margin="6,0,0,0"
                                            Command="{Binding SelectImageSubTabCommand}"
                                            CommandParameter="2"
                                            Content="도시"
                                            FontSize="12">
                                            <support:GameTabButton.Style>
                                                <Style TargetType="{x:Type support:GameTabButton}">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ImageSubTab}" Value="2">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </support:GameTabButton.Style>
                                        </support:GameTabButton>
                                        <support:GameTabButton
                                            Width="70"
                                            Margin="6,0,0,0"
                                            Command="{Binding SelectImageSubTabCommand}"
                                            CommandParameter="3"
                                            Content="건물"
                                            FontSize="12">
                                            <support:GameTabButton.Style>
                                                <Style TargetType="{x:Type support:GameTabButton}">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ImageSubTab}" Value="3">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </support:GameTabButton.Style>
                                        </support:GameTabButton>
                                    </StackPanel>

                                    <!--  공통 갤러리 + 미리보기 (CurrentImage = 선택된 하위 메뉴 VM)  -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <ListBox
                                            Grid.Column="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemsSource="{Binding CurrentImage.Portraits}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            SelectedItem="{Binding CurrentImage.Selected}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="120" Margin="2">
                                                        <Image Width="114" Source="{Binding Thumbnail}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="#EEEEEE"
                                                            Text="{Binding Index}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <ComboBox
                                                Margin="0,0,0,6"
                                                Padding="8,4"
                                                DisplayMemberPath="Display"
                                                FontSize="12"
                                                ItemsSource="{Binding CurrentImage.Files}"
                                                SelectedItem="{Binding CurrentImage.SelectedFile}" />
                                            <Border Background="#33000000" CornerRadius="4" Padding="4">
                                                <Image
                                                    Height="200"
                                                    Source="{Binding CurrentImage.FullImage}"
                                                    Stretch="Uniform" />
                                            </Border>
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="#DDDDDD"
                                                Text="{Binding CurrentImage.Status}"
                                                TextWrapping="Wrap" />
                                            <support:GameFrameButton
                                                Height="38"
                                                Margin="0,8,0,0"
                                                MinWidth="0"
                                                Command="{Binding CurrentImage.ReplaceCommand}"
                                                Content="이미지로 교체"
                                                FontSize="13" />
                                            <support:GameFrameButton
                                                Height="34"
                                                Margin="0,6,0,0"
                                                MinWidth="0"
                                                Command="{Binding CurrentImage.RestoreCommand}"
                                                Content="원본으로 되돌리기"
                                                FontSize="12" />
                                            <support:GameFrameButton
                                                Height="34"
                                                Margin="0,6,0,0"
                                                MinWidth="0"
                                                Command="{Binding CurrentImage.ExportCommand}"
                                                Content="PNG 내보내기"
                                                FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!--  ===== 탭 3: 지도 편집기 (World.dat) =====  -->
                                <Grid
                                    Grid.Row="1"
                                    Margin="10,4,10,10"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=3}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <!--  지도 캔버스 (뷰포트 타일 렌더링 · 드래그 팬 · Ctrl+휠 줌)  -->
                                    <Border
                                        x:Name="PART_MapHost"
                                        Grid.Column="0"
                                        Background="#22000000"
                                        BorderBrush="#241809"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                        <Image
                                            x:Name="PART_MapImage"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            RenderOptions.EdgeMode="Aliased"
                                            Source="{Binding Map.Bitmap}"
                                            Stretch="None" />
                                    </Border>

                                    <!--  편집 컨트롤  -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <support:GameLabel Margin="0,0,0,4" Content="브러시" />
                                        <support:GameFrameButton
                                            Height="32"
                                            MinWidth="0"
                                            Command="{Binding Map.SetModeSeaCommand}"
                                            Content="바다로"
                                            FontSize="12" />
                                        <support:GameFrameButton
                                            Height="32"
                                            Margin="0,4,0,0"
                                            MinWidth="0"
                                            Command="{Binding Map.SetModeLandCommand}"
                                            Content="육지로"
                                            FontSize="12" />
                                        <support:GameFrameButton
                                            Height="32"
                                            Margin="0,4,0,0"
                                            MinWidth="0"
                                            Command="{Binding Map.SetModeEyedropperCommand}"
                                            Content="스포이드"
                                            FontSize="12" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="11"
                                            Foreground="#E0B45C"
                                            Text="{Binding Map.PaintValueText}" />

                                        <support:GameLabel Margin="0,10,0,4" Content="브러시 크기" />
                                        <StackPanel Orientation="Horizontal">
                                            <support:GameFrameButton
                                                Width="44"
                                                Height="30"
                                                MinWidth="0"
                                                Command="{Binding Map.BrushSmallCommand}"
                                                Content="1"
                                                FontSize="12" />
                                            <support:GameFrameButton
                                                Width="44"
                                                Height="30"
                                                Margin="4,0,0,0"
                                                MinWidth="0"
                                                Command="{Binding Map.BrushMediumCommand}"
                                                Content="3"
                                                FontSize="12" />
                                            <support:GameFrameButton
                                                Width="44"
                                                Height="30"
                                                Margin="4,0,0,0"
                                                MinWidth="0"
                                                Command="{Binding Map.BrushLargeCommand}"
                                                Content="7"
                                                FontSize="12" />
                                        </StackPanel>

                                        <support:GameLabel Margin="0,10,0,4" Content="확대" />
                                        <StackPanel Orientation="Horizontal">
                                            <support:GameFrameButton
                                                Width="67"
                                                Height="30"
                                                MinWidth="0"
                                                Command="{Binding Map.ZoomOutCommand}"
                                                Content="−"
                                                FontSize="14" />
                                            <support:GameFrameButton
                                                Width="67"
                                                Height="30"
                                                Margin="4,0,0,0"
                                                MinWidth="0"
                                                Command="{Binding Map.ZoomInCommand}"
                                                Content="+"
                                                FontSize="14" />
                                        </StackPanel>

                                        <support:GameLabel Margin="0,10,0,4" Content="바로가기" />
                                        <support:GameFrameButton
                                            Height="30"
                                            MinWidth="0"
                                            Command="{Binding Map.JumpSuezCommand}"
                                            Content="수에즈"
                                            FontSize="12" />
                                        <support:GameFrameButton
                                            Height="30"
                                            Margin="0,4,0,0"
                                            MinWidth="0"
                                            Command="{Binding Map.JumpPanamaCommand}"
                                            Content="파나마"
                                            FontSize="12" />

                                        <support:GameFrameButton
                                            Height="34"
                                            Margin="0,12,0,0"
                                            MinWidth="0"
                                            Command="{Binding Map.SaveCommand}"
                                            Content="저장"
                                            FontSize="13" />
                                        <support:GameFrameButton
                                            Height="30"
                                            Margin="0,4,0,0"
                                            MinWidth="0"
                                            Command="{Binding Map.ResetCommand}"
                                            Content="초기화"
                                            FontSize="12" />
                                        <support:GameFrameButton
                                            Height="30"
                                            Margin="0,4,0,0"
                                            MinWidth="0"
                                            Command="{Binding Map.RestoreCommand}"
                                            Content="원본 복원"
                                            FontSize="12" />

                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="11"
                                            Foreground="#BBBBBB"
                                            Text="{Binding Map.CursorText}" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="11"
                                            Foreground="#DDDDDD"
                                            Text="{Binding Map.Status}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <!--  ===== 탭 4: 세이브 편집 (savedatNN.dk4) =====  -->
                                <Grid
                                    Grid.Row="1"
                                    Margin="10,4,10,10"
                                    Visibility="{Binding SelectedTab, Converter={StaticResource EqVis}, ConverterParameter=4}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>

                                    <!--  슬롯 목록  -->
                                    <ListBox
                                        Grid.Column="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding SaveEdit.Slots}"
                                        SelectedItem="{Binding SaveEdit.SelectedSlot}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="13"
                                                        Foreground="#EEEEEE"
                                                        Text="{Binding SlotNumber, StringFormat='슬롯 {0}'}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="13"
                                                        Foreground="#E0B45C"
                                                        Text="{Binding Money, StringFormat='{}{0:N0}'}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        FontSize="11"
                                                        Foreground="#9A9A9A"
                                                        Text="{Binding LastModified, StringFormat='MM-dd HH:mm'}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!--  편집 패널  -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <support:GameLabel Margin="0,0,0,4" Content="세이브 슬롯" />
                                        <support:GameFrameButton
                                            Height="32"
                                            MinWidth="0"
                                            Command="{Binding SaveEdit.ReloadCommand}"
                                            Content="새로고침"
                                            FontSize="12" />

                                        <support:GameLabel Margin="0,14,0,4" Content="보유 자금" />
                                        <TextBox
                                            Padding="8,5"
                                            FontSize="14"
                                            Text="{Binding SaveEdit.Money, UpdateSourceTrigger=PropertyChanged}" />
                                        <support:GameFrameButton
                                            Height="38"
                                            Margin="0,8,0,0"
                                            MinWidth="0"
                                            Command="{Binding SaveEdit.ApplyMoneyCommand}"
                                            Content="자금 적용"
                                            FontSize="13" />

                                        <TextBlock
                                            Margin="0,10,0,0"
                                            FontSize="12"
                                            Foreground="#DDDDDD"
                                            Text="{Binding SaveEdit.Status}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            FontSize="11"
                                            Foreground="#C8A050"
                                            Text="※ 게임을 완전히 종료한 뒤 적용하세요. 첫 적용 시 원본은 .bak으로 자동 백업됩니다."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <!--  ===== 하단 고정 바: 게임 실행 (모든 탭 공통) =====  -->
                                <Border
                                    Grid.Row="2"
                                    Background="#3E2C1A"
                                    BorderBrush="#241809"
                                    BorderThickness="0,1,0,0">
                                    <Grid Margin="12,8">
                                        <StackPanel
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            MaxWidth="150">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#6FCF6F"
                                                Text="{Binding StatusMessage}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding StatusMessage}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="#E0B45C"
                                                Text="{Binding UpdateStatus}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding UpdateStatus}" />
                                        </StackPanel>
                                        <support:GameFrameButton
                                            Width="220"
                                            Height="48"
                                            HorizontalAlignment="Center"
                                            Command="{Binding LaunchCommand}"
                                            Content="게임 실행" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
