<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:support="clr-namespace:Dh4Launcher.Support.UI.Units;assembly=Dh4Launcher.Support"
    xmlns:views="clr-namespace:Dh4Launcher.Forms.UI.Views">

    <!--  배경색은 버튼별로 지정, 호버/비활성은 투명도로 처리해 색에 무관하게 동작  -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Type support:Dh4LauncherWindow}}" TargetType="{x:Type views:MainWindow}">
        <Setter Property="Title" Value="Dh4Launcher" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:MainWindow}">
                    <Border
                        Background="#1E1E1E"
                        BorderBrush="#3C3C3C"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Title Bar  -->
                            <Grid Grid.Row="0" Background="#2D2D2D">
                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#CCCCCC"
                                    Text="{TemplateBinding Title}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <!--  Minimize  -->
                                    <support:MinimizeButton x:Name="PART_MinimizeButton" />
                                    <!--  Maximize  -->
                                    <support:MaximizeButton x:Name="PART_MaximizeButton" />
                                    <!--  Close  -->
                                    <support:CloseButton x:Name="PART_CloseButton" />
                                </StackPanel>
                            </Grid>

                            <!--  Content Area  -->
                            <Grid Grid.Row="1">
                                <StackPanel
                                    Margin="40,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="14"
                                        Foreground="#CCCCCC"
                                        Text="해상도" />
                                    <ComboBox
                                        Width="220"
                                        Padding="8,4"
                                        FontSize="14"
                                        ItemsSource="{Binding Resolutions}"
                                        SelectedItem="{Binding SelectedResolution}" />

                                    <CheckBox
                                        Margin="0,16,0,0"
                                        Content="전체 화면"
                                        Foreground="#CCCCCC"
                                        IsChecked="{Binding IsFullscreen}" />

                                    <TextBlock
                                        Margin="0,16,0,8"
                                        FontSize="14"
                                        Foreground="#CCCCCC"
                                        Text="언어" />
                                    <ComboBox
                                        Width="220"
                                        Padding="8,4"
                                        FontSize="14"
                                        ItemsSource="{Binding Languages}"
                                        SelectedItem="{Binding SelectedLanguage}" />

                                    <!--  고성능 GPU 설정  -->
                                    <TextBlock
                                        Margin="0,16,0,4"
                                        FontSize="14"
                                        Foreground="#CCCCCC"
                                        Text="고성능 GPU" />
                                    <TextBlock
                                        Width="220"
                                        FontSize="12"
                                        Foreground="#9A9A9A"
                                        Text="{Binding GpuStatus}"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        Width="220"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                        <Button
                                            Width="105"
                                            Height="34"
                                            Background="#0078D4"
                                            Command="{Binding ApplyGpuCommand}"
                                            Content="적용"
                                            FontSize="13"
                                            Style="{StaticResource FlatButton}" />
                                        <Button
                                            Width="105"
                                            Height="34"
                                            Margin="10,0,0,0"
                                            Background="#5A5A5A"
                                            Command="{Binding CancelGpuCommand}"
                                            Content="취소"
                                            FontSize="13"
                                            Style="{StaticResource FlatButton}" />
                                    </StackPanel>

                                    <!--  방향 키 매핑 (DK4HD_kr.exe 패치)  -->
                                    <TextBlock
                                        Margin="0,16,0,4"
                                        FontSize="14"
                                        Foreground="#CCCCCC"
                                        Text="돛 조타 키 (좌/우)" />
                                    <StackPanel Width="220" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="왼쪽" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding LeftKey}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="오른쪽" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding RightKey}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Margin="0,10,0,4"
                                        FontSize="14"
                                        Foreground="#CCCCCC"
                                        Text="배 선회 키 (위/아래)" />
                                    <StackPanel Width="220" Orientation="Horizontal">
                                        <StackPanel Width="105">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="위" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding UpKey}" />
                                        </StackPanel>
                                        <StackPanel Width="105" Margin="10,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9A9A9A"
                                                Text="아래" />
                                            <ComboBox
                                                Margin="0,2,0,0"
                                                Padding="8,4"
                                                FontSize="13"
                                                ItemsSource="{Binding Keys}"
                                                SelectedItem="{Binding DownKey}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel
                                        Width="220"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                        <Button
                                            Width="105"
                                            Height="34"
                                            Background="#0078D4"
                                            Command="{Binding ApplyKeyMapCommand}"
                                            Content="적용"
                                            FontSize="13"
                                            Style="{StaticResource FlatButton}" />
                                        <Button
                                            Width="105"
                                            Height="34"
                                            Margin="10,0,0,0"
                                            Background="#5A5A5A"
                                            Command="{Binding RestoreKeyMapCommand}"
                                            Content="기본값(←→)"
                                            FontSize="13"
                                            Style="{StaticResource FlatButton}" />
                                    </StackPanel>
                                    <TextBlock
                                        Width="220"
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="#9A9A9A"
                                        Text="{Binding KeyMapStatus}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        Width="220"
                                        Height="40"
                                        Margin="0,20,0,0"
                                        Background="#0078D4"
                                        BorderThickness="0"
                                        Command="{Binding SaveCommand}"
                                        Content="적용"
                                        FontSize="14"
                                        Foreground="White">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#106EBE" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#005A9E" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button
                                        Width="220"
                                        Height="44"
                                        Margin="0,10,0,0"
                                        Background="#2E7D32"
                                        BorderThickness="0"
                                        Command="{Binding LaunchCommand}"
                                        Content="게임 실행"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="White">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#388E3C" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#1B5E20" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <TextBlock
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#6FCF6F"
                                        Text="{Binding StatusMessage}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
