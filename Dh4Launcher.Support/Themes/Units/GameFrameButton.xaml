<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:units="clr-namespace:Dh4Launcher.Support.UI.Units">

    <!--  갈색/금색 그라데이션 테두리 프레임 (위 밝은 금색 → 아래 어두운 갈색, 양각 느낌)  -->
    <LinearGradientBrush x:Key="FrameBrown" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F0DEAA" />
        <GradientStop Offset="0.35" Color="#CDA864" />
        <GradientStop Offset="0.72" Color="#8C6630" />
        <GradientStop Offset="1" Color="#5A3F1B" />
    </LinearGradientBrush>

    <!--  내부 파란 패널  -->
    <LinearGradientBrush x:Key="FrameInnerBlue" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#5CA1E6" />
        <GradientStop Offset="0.48" Color="#2E6CB4" />
        <GradientStop Offset="0.52" Color="#255FA6" />
        <GradientStop Offset="1" Color="#15366B" />
    </LinearGradientBrush>

    <Style TargetType="{x:Type units:GameFrameButton}">
        <Setter Property="Height" Value="54" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:GameFrameButton}">
                    <Grid>
                        <!--  포커스/hover 밝은 테두리  -->
                        <Border
                            x:Name="Focus"
                            Margin="-2"
                            BorderBrush="#F2F2F2"
                            BorderThickness="2"
                            CornerRadius="11"
                            Opacity="0" />

                        <!--  바깥 진한 윤곽선  -->
                        <Border Background="#3A2A12" CornerRadius="8" />

                        <!--  갈색/금색 그라데이션 프레임 (약 2px)  -->
                        <Border
                            x:Name="Frame"
                            Margin="1"
                            Background="{StaticResource FrameBrown}"
                            CornerRadius="7" />

                        <!--  내부 파란 패널  -->
                        <Border
                            x:Name="Inner"
                            Margin="3"
                            Background="{StaticResource FrameInnerBlue}"
                            BorderBrush="#0E2440"
                            BorderThickness="1"
                            CornerRadius="5" />

                        <!--  내부 상단 광택  -->
                        <Border
                            Height="13"
                            Margin="6,5,6,0"
                            VerticalAlignment="Top"
                            CornerRadius="4,4,8,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#7AFFFFFF" />
                                    <GradientStop Offset="1" Color="#10FFFFFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!--  텍스트  -->
                        <ContentPresenter
                            Margin="8,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Effect>
                                <DropShadowEffect
                                    BlurRadius="3"
                                    Opacity="0.85"
                                    ShadowDepth="1"
                                    Color="#08182E" />
                            </ContentPresenter.Effect>
                        </ContentPresenter>

                        <!--  hover 밝아짐  -->
                        <Border
                            x:Name="Bright"
                            Margin="3"
                            Background="White"
                            CornerRadius="5"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bright" Property="Opacity" Value="0.18" />
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bright" Property="Opacity" Value="0.06" />
                            <Setter TargetName="Inner" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
