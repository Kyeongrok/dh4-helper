<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:units="clr-namespace:Dh4Launcher.Support.UI.Units">

    <!--  파란 명판 그라데이션 (위 밝음 → 아래 어두움, 가운데 광택 경계)  -->
    <LinearGradientBrush x:Key="GameBtnBlue" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#6FB2EE" />
        <GradientStop Offset="0.45" Color="#3E84C8" />
        <GradientStop Offset="0.5" Color="#2A6CB4" />
        <GradientStop Offset="0.55" Color="#225EA6" />
        <GradientStop Offset="1" Color="#16386E" />
    </LinearGradientBrush>

    <!--  금색 장식 그라데이션  -->
    <LinearGradientBrush x:Key="GameBtnGold" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FBE6A6" />
        <GradientStop Offset="0.4" Color="#E6BC63" />
        <GradientStop Offset="0.78" Color="#A9772B" />
        <GradientStop Offset="1" Color="#765019" />
    </LinearGradientBrush>

    <Style TargetType="{x:Type units:GameButton}">
        <Setter Property="Height" Value="52" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:GameButton}">
                    <Grid>
                        <!--  포커스/hover 밝은 테두리  -->
                        <Border
                            x:Name="Frame"
                            Margin="-2"
                            BorderBrush="#F2F2F2"
                            BorderThickness="2"
                            CornerRadius="11"
                            Opacity="0" />

                        <!--  금색 장식 끝 (명판보다 바깥으로 살짝 나오게)  -->
                        <Grid Margin="0,2">
                            <Border
                                Width="28"
                                HorizontalAlignment="Left"
                                Background="{StaticResource GameBtnGold}"
                                BorderBrush="#5E3F12"
                                BorderThickness="1.2"
                                CornerRadius="10,4,4,10">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="#FCEBB0"
                                    Stroke="#7A5318"
                                    StrokeThickness="1" />
                            </Border>
                            <Border
                                Width="28"
                                HorizontalAlignment="Right"
                                Background="{StaticResource GameBtnGold}"
                                BorderBrush="#5E3F12"
                                BorderThickness="1.2"
                                CornerRadius="4,10,10,4">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="#FCEBB0"
                                    Stroke="#7A5318"
                                    StrokeThickness="1" />
                            </Border>
                        </Grid>

                        <!--  파란 명판  -->
                        <Border
                            x:Name="Body"
                            Margin="15,0"
                            Background="{StaticResource GameBtnBlue}"
                            BorderBrush="#0C2A50"
                            BorderThickness="2"
                            CornerRadius="6" />

                        <!--  안쪽 베벨 하이라이트  -->
                        <Border
                            Margin="17,2"
                            BorderBrush="#86C0F2"
                            BorderThickness="1"
                            CornerRadius="5"
                            Opacity="0.55" />

                        <!--  상단 광택  -->
                        <Border
                            Height="15"
                            Margin="18,3,18,0"
                            VerticalAlignment="Top"
                            CornerRadius="5,5,9,9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#80FFFFFF" />
                                    <GradientStop Offset="1" Color="#10FFFFFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!--  텍스트  -->
                        <ContentPresenter
                            Margin="30,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Effect>
                                <DropShadowEffect
                                    BlurRadius="3"
                                    Opacity="0.8"
                                    ShadowDepth="1"
                                    Color="#0A1B33" />
                            </ContentPresenter.Effect>
                        </ContentPresenter>

                        <!--  hover 밝아짐 오버레이  -->
                        <Border
                            x:Name="Bright"
                            Margin="15,0"
                            Background="White"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bright" Property="Opacity" Value="0.20" />
                            <Setter TargetName="Frame" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bright" Property="Opacity" Value="0.06" />
                            <Setter TargetName="Body" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
