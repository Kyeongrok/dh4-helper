<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:units="clr-namespace:Dh4Launcher.Support.UI.Units">

    <!--  밝은 크림 테두리  -->
    <LinearGradientBrush x:Key="TabBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#EFE6BE" />
        <GradientStop Offset="1" Color="#B6A877" />
    </LinearGradientBrush>

    <!--  광택 파란 명판  -->
    <LinearGradientBrush x:Key="TabBlue" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#62A9EC" />
        <GradientStop Offset="0.48" Color="#327FCB" />
        <GradientStop Offset="0.52" Color="#2A6FBC" />
        <GradientStop Offset="1" Color="#163C72" />
    </LinearGradientBrush>

    <Style TargetType="{x:Type units:GameTabButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:GameTabButton}">
                    <Grid>
                        <!--  바깥 진한 윤곽선  -->
                        <Border Background="#16345A" CornerRadius="7" />
                        <!--  밝은 크림 테두리  -->
                        <Border Margin="1" Background="{StaticResource TabBorder}" CornerRadius="6" />
                        <!--  파란 명판  -->
                        <Border
                            x:Name="Body"
                            Margin="3"
                            Background="{StaticResource TabBlue}"
                            BorderBrush="#0E2E54"
                            BorderThickness="1"
                            CornerRadius="4" />
                        <!--  상단 광택  -->
                        <Border
                            Height="10"
                            Margin="5,4,5,0"
                            VerticalAlignment="Top"
                            CornerRadius="4,4,8,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#70FFFFFF" />
                                    <GradientStop Offset="1" Color="#10FFFFFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter
                            Margin="12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Effect>
                                <DropShadowEffect
                                    BlurRadius="2"
                                    Opacity="0.85"
                                    ShadowDepth="1"
                                    Color="#0A1B33" />
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                        <!--  hover 밝아짐  -->
                        <Border
                            x:Name="Bright"
                            Margin="3"
                            Background="White"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bright" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
