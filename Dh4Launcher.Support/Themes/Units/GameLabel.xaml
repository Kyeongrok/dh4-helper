<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:units="clr-namespace:Dh4Launcher.Support.UI.Units">

    <!--  남색 명판 그라데이션  -->
    <LinearGradientBrush x:Key="LabelNavy" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#52527A" />
        <GradientStop Offset="0.5" Color="#38385C" />
        <GradientStop Offset="0.52" Color="#30304F" />
        <GradientStop Offset="1" Color="#23233C" />
    </LinearGradientBrush>

    <!--  금색/크림 테두리  -->
    <LinearGradientBrush x:Key="LabelGold" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#ECE0B4" />
        <GradientStop Offset="0.5" Color="#CBB987" />
        <GradientStop Offset="1" Color="#A99668" />
    </LinearGradientBrush>

    <Style TargetType="{x:Type units:GameLabel}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="#F2F0FF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:GameLabel}">
                    <Grid>
                        <!--  바깥 진한 윤곽선  -->
                        <Border Background="#15152A" CornerRadius="5" />
                        <!--  금색 테두리  -->
                        <Border Margin="1" Background="{StaticResource LabelGold}" CornerRadius="4" />
                        <!--  남색 내부 명판  -->
                        <Border
                            Margin="3"
                            Background="{StaticResource LabelNavy}"
                            BorderBrush="#15152A"
                            BorderThickness="1"
                            CornerRadius="3" />
                        <!--  상단 광택  -->
                        <Border
                            Height="9"
                            Margin="5,4,5,0"
                            VerticalAlignment="Top"
                            CornerRadius="3,3,6,6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#55FFFFFF" />
                                    <GradientStop Offset="1" Color="#08FFFFFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!--  텍스트  -->
                        <ContentPresenter
                            Margin="14,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Effect>
                                <DropShadowEffect
                                    BlurRadius="2"
                                    Opacity="0.8"
                                    ShadowDepth="1"
                                    Color="#0A0A18" />
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
